generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(false)
  flag      String?
  phoneCode String
  currency  String
  createdAt DateTime @default(now())
  rides     Ride[]
  users     User[]
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  password             String
  name                 String
  phone                String
  photoUrl             String?
  countryId            String
  role                 Role           @default(USER)
  isActive             Boolean        @default(true)
  rating               Float          @default(0)
  createdAt            DateTime       @default(now())
  age                  Int?
  bio                  String?
  birthDate            DateTime?
  emailVerified        Boolean        @default(false)
  experienceLevel      String?
  phoneVerified        Boolean        @default(false)
  preferences          String?
  registrationDate     DateTime       @default(now())
  totalTrips           Int            @default(0)
  expoPushToken        String?
  notificationsEnabled Boolean        @default(true)
  cniNumber            String?
  cniVerified          Boolean        @default(false)
  gallery              String[]
  cniExpiryDate        DateTime?
  language             String         @default("fr")
  resetToken           String?        @unique
  resetTokenExpiry     DateTime?
  telegramChatId       String?        @unique
  bookings             Booking[]
  messagesReceived     Message[]      @relation("ReceiverMessages")
  messagesSent         Message[]      @relation("SenderMessages")
  notifications        Notification[]
  conversations        Participant[]
  reviewsGiven         Review[]       @relation("Reviewer")
  reviewsReceived      Review[]       @relation("Target")
  ridesAsDriver        Ride[]         @relation("DriverRides")
  transactions         Transaction[]
  country              Country        @relation(fields: [countryId], references: [id])
  isVerified      Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
}

model Ride {
  id                String         @id @default(cuid())
  driverId          String
  countryId         String
  departure         String
  destination       String
  date              DateTime
  price             Float
  availableSeats    Int            @default(4)
  vehicleType       VehicleType
  vehicleBrand      String
  status            RideStatus     @default(SCHEDULED)
  createdAt         DateTime       @default(now())
  dropoffPoint      String?
  isRecurring       Boolean        @default(false)
  meetingPoint      String?
  arrivalTime       DateTime?
  estimatedDuration Int?
  licensePlate      String?
  isHidden          Boolean        @default(false)
  reminderSent10min Boolean        @default(false)
  reminderSent15min Boolean        @default(false)
  reminderSent2h    Boolean        @default(false)
  reminderSent30min Boolean        @default(false)
  reminderSent5min  Boolean        @default(false)
  securitySent      Boolean        @default(false)
  totalSeats        Int            @default(4)
  bookings          Booking[]
  conversations     Conversation[]
  reviews           Review[]
  country           Country        @relation(fields: [countryId], references: [id])
  driver            User           @relation("DriverRides", fields: [driverId], references: [id])
  transactions      Transaction[]
}

model Booking {
  id              String        @id @default(cuid())
  rideId          String
  passengerId     String
  seats           Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  amount          Float?
  bookerName      String?
  bookerPhone     String?
  idExpiryDate    DateTime?
  idNumber        String?
  paymentMethod   String?
  travelerName    String?
  travelerPhone   String?
  ratingSent      Boolean       @default(false)
  reminderSent    Boolean       @default(false)
  securitySent    Boolean       @default(false)
  canRate         Boolean       @default(true)
  ratingDeadline  DateTime?
  trustedContact1 String?
  trustedContact2 String?
  trustedContact3 String?
  ratingComment   String?
  ratingDate      DateTime?
  ratingGiven     Boolean       @default(false)
  ratingValue     Int?
  transactionId   String?
  passenger       User          @relation(fields: [passengerId], references: [id])
  ride            Ride          @relation(fields: [rideId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  rideId     String
  reviewerId String
  targetId   String
  rating     Int
  comment    String?
  category   String?
  createdAt  DateTime @default(now())
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  ride       Ride     @relation(fields: [rideId], references: [id])
  target     User     @relation("Target", fields: [targetId], references: [id])
}

model Conversation {
  id           String        @id @default(cuid())
  rideId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ride         Ride?         @relation(fields: [rideId], references: [id])
  messages     Message[]
  participants Participant[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  receiverId     String
  isDelivered    Boolean      @default(false)
  fileName       String?
  fileSize       Int?
  fileUrl        String?
  type           String       @default("text")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  receiver       User         @relation("ReceiverMessages", fields: [receiverId], references: [id])
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id])
}

model Transaction {
  id                     String   @id
  rideId                 String
  passengerId            String
  amount                 Float
  driverAmount           Float
  processor              String
  status                 String
  paymentMethod          String
  processorTransactionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  bookingId              String?
  passenger              User     @relation(fields: [passengerId], references: [id])
  ride                   Ride     @relation(fields: [rideId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum VehicleType {
  MOTO
  TAXI
  MINIBUS
  BUS
  COASTER
  CAMION
  AUTRE
}

enum RideStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
