generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(false)
  flag      String?
  phoneCode String
  currency  String
  createdAt DateTime @default(now())
  rides     Ride[]
  users     User[]
  cities    City[] // 👈 RELATION AJOUTÉE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  name                 String
  phone                String
  photoUrl             String?
  countryId            String
  role                 Role      @default(USER)
  isActive             Boolean   @default(true)
  rating               Float     @default(0)
  createdAt            DateTime  @default(now())
  age                  Int?
  bio                  String?
  birthDate            DateTime?
  emailVerified        Boolean   @default(false)
  experienceLevel      String?
  phoneVerified        Boolean   @default(false)
  preferences          String?
  registrationDate     DateTime  @default(now())
  totalTrips           Int       @default(0)
  expoPushToken        String?
  notificationsEnabled Boolean   @default(true)
  cniNumber            String?
  cniVerified          Boolean   @default(false)
  gallery              String[]
  cniExpiryDate        DateTime?
  language             String    @default("fr")
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  telegramChatId       String?   @unique
  isVerified           Boolean   @default(false)
  otpCode              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int       @default(0)

  // ========== CHAMPS POUR PAIEMENT ET RÉCEPTION ==========
  paymentMethod     String? @default("mobile_money") // mobile_money, bank_card, bank_transfer
  receptionMethod   String? @default("mobile_money") // mobile_money, bank_card
  mobileMoneyNumber String? // Numéro Orange Money/MTN/Wave
  bankCardNumber    String? // Numéro de carte bancaire
  bankCardExpiry    String? // MM/YY
  bankCardCvv       String? // CVV
  bankName          String? // Nom de la banque
  bankAccountName   String? // Titulaire du compte
  bankAccountNumber String? // Numéro de compte bancaire
  bankIban          String? // IBAN (pour virements internationaux)
  bankSwiftCode     String? // Code SWIFT/BIC

  bookings             Booking[]
  messagesReceived     Message[]       @relation("ReceiverMessages")
  messagesSent         Message[]       @relation("SenderMessages")
  notifications        Notification[]
  conversations        Participant[]
  reviewsGiven         Review[]        @relation("Reviewer")
  reviewsReceived      Review[]        @relation("Target")
  ridesAsDriver        Ride[]          @relation("DriverRides")
  sentTransactions     Transaction[]   @relation("PassengerTransactions")
  receivedTransactions Transaction[]   @relation("DriverTransactions")
  driverPenalties      DriverPenalty[]
  country              Country         @relation(fields: [countryId], references: [id])
}

model Ride {
  id                String      @id @default(cuid())
  driverId          String
  countryId         String
  departure         String
  destination       String
  date              DateTime
  price             Float
  availableSeats    Int         @default(4)
  vehicleType       VehicleType
  vehicleBrand      String
  status            RideStatus  @default(SCHEDULED)
  createdAt         DateTime    @default(now())
  dropoffPoint      String?
  isRecurring       Boolean     @default(false)
  meetingPoint      String?
  arrivalTime       DateTime?
  estimatedDuration Int?
  licensePlate      String?
  isHidden          Boolean     @default(false)
  reminderSent10min Boolean     @default(false)
  reminderSent15min Boolean     @default(false)
  reminderSent2h    Boolean     @default(false)
  reminderSent30min Boolean     @default(false)
  reminderSent5min  Boolean     @default(false)
  securitySent      Boolean     @default(false)
  totalSeats        Int         @default(4)

  // ========== PAIEMENT HYBRIDE ==========
  onlinePaymentPercent Int    @default(100) // 100, 50, 25, 10
  displayCurrency      String @default("XAF") // XAF, XOF, EUR, USD

  // ========== RÉCEPTION PAIEMENT CONDUCTEUR ==========
  receptionMethod       String? @default("mobile_money") // mobile_money, bank_card
  receiverPhone         String? // Mobile Money
  receiverCardNumber    String? // Carte bancaire
  receiverCardExpiry    String?
  receiverCardCvv       String?
  receiverBankName      String? // Nom de la banque
  receiverAccountName   String? // Titulaire du compte
  receiverAccountNumber String? // Numéro de compte
  receiverIban          String? // IBAN
  receiverSwiftCode     String? // Code SWIFT/BIC

  bookings      Booking[]
  conversations Conversation[]
  reviews       Review[]
  country       Country        @relation(fields: [countryId], references: [id])
  driver        User           @relation("DriverRides", fields: [driverId], references: [id])
  transactions  Transaction[]
}

model Booking {
  id              String        @id @default(cuid())
  rideId          String
  passengerId     String
  seats           Int
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  amount          Float?
  bookerName      String?
  bookerPhone     String?
  idExpiryDate    DateTime?
  idNumber        String?
  paymentMethod   String?
  travelerName    String?
  travelerPhone   String?
  ratingSent      Boolean       @default(false)
  reminderSent    Boolean       @default(false)
  securitySent    Boolean       @default(false)
  canRate         Boolean       @default(true)
  ratingDeadline  DateTime?
  trustedContact1 String?
  trustedContact2 String?
  trustedContact3 String?
  ratingComment   String?
  ratingDate      DateTime?
  ratingGiven     Boolean       @default(false)
  ratingValue     Int?
  transactionId   String?

  // ========== PAIEMENT HYBRIDE ==========
  onlineAmount         Float?    @map("online_amount") // Montant payé en ligne
  cashAmount           Float?    @map("cash_amount") // Montant à payer en espèces
  cashAmountPaid       Float?    @default(0) @map("cash_amount_paid")
  cashPaymentConfirmed Boolean   @default(false) @map("cash_payment_confirmed")
  cashPaymentDate      DateTime? @map("cash_payment_date")
  paymentStatus        String    @default("PENDING") @map("payment_status") // PENDING, HELD, RELEASED, REFUNDED, CANCELLED
  flutterwaveRef       String?   @map("flutterwave_ref")
  payoutReference      String?   @map("payout_reference")
  paymentReleasedAt    DateTime? @map("payment_released_at")

  passenger User @relation(fields: [passengerId], references: [id])
  ride      Ride @relation(fields: [rideId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  rideId     String
  reviewerId String
  targetId   String
  rating     Int
  comment    String?
  category   String?
  createdAt  DateTime @default(now())
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  ride       Ride     @relation(fields: [rideId], references: [id])
  target     User     @relation("Target", fields: [targetId], references: [id])
}

model Conversation {
  id           String        @id @default(cuid())
  rideId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ride         Ride?         @relation(fields: [rideId], references: [id])
  messages     Message[]
  participants Participant[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  receiverId     String
  isDelivered    Boolean      @default(false)
  fileName       String?
  fileSize       Int?
  fileUrl        String?
  type           String       @default("text")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  receiver       User         @relation("ReceiverMessages", fields: [receiverId], references: [id])
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id])
}

model Transaction {
  id                     String            @id @default(cuid())
  rideId                 String
  passengerId            String
  driverId               String
  totalAmount            Float // Prix total du trajet
  onlineAmount           Float // Montant payé en ligne
  cashAmount             Float // Montant à payer en espèces
  onlinePercent          Int               @default(100) // Pourcentage payé en ligne
  driverAmount           Float // Montant que le conducteur reçoit
  commission             Float // Commission Auto-stop
  processorFees          Float? // Frais processeur
  status                 TransactionStatus @default(PENDING)
  paymentMethod          String
  transactionRef         String?           @unique
  transferRef            String?
  processor              String?
  processorTransactionId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  releasedAt             DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  bookingId              String?

  passenger User     @relation("PassengerTransactions", fields: [passengerId], references: [id])
  driver    User     @relation("DriverTransactions", fields: [driverId], references: [id])
  ride      Ride     @relation(fields: [rideId], references: [id])
  refunds   Refund[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========== PÉNALITÉS CONDUCTEUR ==========
model DriverPenalty {
  id           String   @id @default(cuid())
  driverId     String
  penaltyCount Int      @default(1) // 1, 2, 3...
  multiplier   Int      @default(1) // 1x, 2x, 3x commission
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id])
}

// ========== REMBOURSEMENTS ==========
model Refund {
  id            String   @id @default(cuid())
  transactionId String
  amount        Float
  reason        String
  refundPercent Int // 100, 50, 0
  hoursBefore   Float // Heures avant départ
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

// ========== VILLES POUR GÉOFENCING ==========
model City {
  id        String   @id @default(cuid())
  name      String
  countryId String
  latitude  Float
  longitude Float
  radius    Int      @default(500) // Rayon de détection en mètres
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])

  @@unique([name, countryId])
}

enum Role {
  USER
  ADMIN
}

enum VehicleType {
  MOTO
  TAXI
  MINIBUS
  BUS
  COASTER
  CAMION
  AUTRE
}

enum RideStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TransactionStatus {
  PENDING // En attente de paiement
  HELD // Paiement reçu, fonds bloqués (séquestre)
  RELEASING // Virement en cours
  RELEASED // Fonds transférés au conducteur
  REFUNDED // Remboursé au passager
  CANCELLED // Annulé (pénalités appliquées)
  FAILED // Échec
}
